# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO VERCEL
# ==========================================

# 1. Cloudflare D1 Database (Lưu trữ bài viết, dự án, tuyển dụng)
# Lấy từ Cloudflare Dashboard -> Workers & Pages -> D1
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="your_cloudflare_database_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# 2. Cloudinary Media Storage (Lưu trữ và nén ảnh thành link URL)
# Lấy từ Cloudinary Dashboard -> Settings
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="trunghai_uploads"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 3. Next.js Base URL (Tự động nhận diện trên Vercel)
NEXT_PUBLIC_APP_URL="https://trunghaico.vn"
